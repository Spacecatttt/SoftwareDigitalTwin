   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-dt"
     },
     "query": "from(bucket: \"digital_twin\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"telemetry_raw\" and r.printer_id == \"${printer}\" and r.metric == \"nozzle_temperature\" and r._field == \"value\") |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false) |> map(fn: (r) => ({_time: r._time, _value: r._value, _field: \"сирі (raw)\"}))"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-dt"
     },
     "query": "from(bucket: \"digital_twin\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"telemetry_raw\" and r.printer_id == \"${printer}\" and r.metric == \"nozzle_temperature\" and r._field == \"filtered\") |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false) |> map(fn: (r) => ({_time: r._time, _value: r._value, _field: \"після фільтра Гампеля\"}))"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-dt"
     },
     "query": "from(bucket: \"digital_twin\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"telemetry_resampled\" and r.printer_id == \"${printer}\" and r.metric == \"nozzle_temperature\" and r._field == \"mean\") |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false) |> map(fn: (r) => ({_time: r._time, _value: r._value, _field: \"1 с сітка (resampled)\"}))"
    }
   ],
