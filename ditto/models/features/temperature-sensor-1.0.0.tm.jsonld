{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "om2": "http://www.ontology-of-units-of-measure.org/resource/om-2/",
      "saref": "https://w3id.org/saref#",
      "dt": "http://wot-models/models/vocab#"
    }
  ],
  "@type": [
    "tm:ThingModel"
  ],
  "title": "Temperature sensor",
  "description": "Temperature sensor (1 Hz, Hampel-filtered by the pipeline).",
  "version": {
    "model": "1.0.0"
  },
  "tm:optional": [
    "/properties/temperature",
    "/properties/measuredAt"
  ],
  "properties": {
    "temperature": {
      "title": "Temperature",
      "description": "Filtered temperature.",
      "type": "number",
      "@type": "om2:CelsiusTemperature",
      "unit": "°C",
      "minimum": 0,
      "maximum": 350,
      "readOnly": true
    },
    "quality": {
      "title": "Data quality",
      "description": "Quality flag of the value from the pipeline: GOOD - as measured, FILTERED - an outlier was replaced by the last accepted value, STALE - no fresh data (connectivity lost), UNKNOWN - no data yet.",
      "type": "string",
      "enum": [
        "GOOD",
        "FILTERED",
        "STALE",
        "UNKNOWN"
      ],
      "default": "UNKNOWN",
      "readOnly": true
    },
    "measuredAt": {
      "title": "Measured at",
      "description": "Event time (device clock) of the measurement the value comes from.",
      "type": "string",
      "format": "date-time",
      "readOnly": true
    }
  }
}
